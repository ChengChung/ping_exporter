# ping_exporter 环境变量配置示例
# 此文件展示各种常见的配置场景
# 复制此文件到 /etc/default/ping_exporter 并根据需要修改

################################################################################
# 场景 1: 基础配置（推荐用于测试环境）
################################################################################

# 单个 Prometheus 实例
PING_PUSHMETRICS_URLS=http://prometheus:9091/metrics/job/ping

# Ping 配置
PING_INTERVAL=5s
PING_TIMEOUT=5s

# Web 服务配置
PING_LISTEN_ADDRESS=127.0.0.1:9427
PING_LOG_LEVEL=info

# 推送配置
PING_PUSHMETRICS_INTERVAL=15s


################################################################################
# 场景 2: 高可用配置（多个 Prometheus 实例）
################################################################################

# 多个 Prometheus 实例（分号分隔）
# PING_PUSHMETRICS_URLS=http://prom-prod-1:9091/metrics/job/ping;http://prom-prod-2:9091/metrics/job/ping;http://prom-prod-3:9091/metrics/job/ping

# 每个实例都会获得相同的指标，独立的队列


################################################################################
# 场景 3: 高性能配置（快速 Ping）
################################################################################

# 更快的 Ping 间隔
# PING_INTERVAL=2s
# PING_TIMEOUT=3s

# 更快的推送速率
# PING_PUSHMETRICS_INTERVAL=10s

# 增大内存中的队列大小
# PING_PUSHMETRICS_MAX_INMEMORY=50M


################################################################################
# 场景 4: 大规模配置（监控很多 IP）
################################################################################

# 增大历史记录大小
# PING_HISTORY_SIZE=500

# 增大磁盘队列限制
# PING_PUSHMETRICS_MAX_DISK_USAGE=10G

# 自定义数据存储基础目录（队列和缓存都在此）
# PING_PUSHMETRICS_BASE_DIR=/var/lib/ping_exporter


################################################################################
# 场景 5: 安全配置（带标签和 TLS）
################################################################################

# 添加额外标签（分号分隔）
# PING_PUSHMETRICS_LABELS=environment="prod";datacenter="us-west";service="ping_exporter"

# TLS 配置
# PING_TLS_ENABLED=true
# PING_TLS_CERT_FILE=/etc/ping_exporter/cert.pem
# PING_TLS_KEY_FILE=/etc/ping_exporter/key.pem

# 对外访问
# PING_LISTEN_ADDRESS=0.0.0.0:9427


################################################################################
# 完整配置参考
################################################################################

# 【推送指标配置】
# PING_PUSHMETRICS_BASE_DIR      - 推送指标基础目录（含队列和缓存）（默认：/var/lib/ping_exporter）
# PING_PUSHMETRICS_URLS          - Prometheus 推送地址（分号分隔）
# PING_PUSHMETRICS_LABELS        - 额外推送标签（分号分隔）
# PING_PUSHMETRICS_INTERVAL      - 推送间隔（默认：15s）
# PING_PUSHMETRICS_TIMEOUT       - 推送超时（默认：10s）
# PING_PUSHMETRICS_QUEUE_DIR     - 队列存储目录（可选；不设置时从 base_dir/pushmetrics-queue 推断）
# PING_PUSHMETRICS_MAX_DISK_USAGE - 最大磁盘使用（默认：1G）
# PING_PUSHMETRICS_MAX_INMEMORY  - 最大内存队列（默认：10M）

# 【Web 服务器配置】
# PING_LISTEN_ADDRESS            - 监听地址（默认：127.0.0.1:9427）
# PING_METRICS_PATH              - 指标路径（默认：/metrics）
# PING_METRICS_TOKEN             - 访问令牌（可选）
# PING_TLS_ENABLED               - 启用 TLS（默认：false）
# PING_TLS_CERT_FILE             - TLS 证书文件
# PING_TLS_KEY_FILE              - TLS 密钥文件
# PING_TLS_MUTUAL_AUTH           - TLS 双向认证（默认：false）
# PING_TLS_CA_FILE               - TLS CA 文件

# 【配置文件相关】
# PING_CONFIG_FILE               - 配置文件路径（可选）
# PING_CONFIG_REFRESH            - 配置刷新间隔（默认：30s）

# 【Ping 相关配置】
# PING_INTERVAL                  - Ping 间隔（默认：5s）
# PING_TIMEOUT                   - Ping 超时（默认：5s）
# PING_SIZE                      - Ping 包大小（字节）（默认：56）
# PING_FW_MARK                   - iptables 标记（Linux only）
# PING_HISTORY_SIZE              - 历史记录大小（默认：100）

# 【DNS 相关配置】
# PING_DNS_REFRESH               - DNS 刷新间隔（默认：1m）
# PING_DNS_NAMESERVER            - 自定义 DNS 服务器
# PING_DNS_TIMEOUT               - DNS 查询超时（默认：5s）

# 【IP 版本配置】
# PING_DISABLE_IPV6              - 禁用 IPv6（默认：false）
# PING_DISABLE_IPV4              - 禁用 IPv4（默认：false）

# 【日志配置】
# PING_LOG_LEVEL                 - 日志级别：debug, info, warn, error（默认：info）

# 【指标配置】
# PING_METRICS_DEPRECATED        - 启用废弃指标（默认：false）
# PING_METRICS_RTTUNIT           - RTT 单位（默认：ms）


################################################################################
# 故障排查
################################################################################

# 如果遇到问题，可以启用调试日志：
# PING_LOG_LEVEL=debug

# 然后查看日志：
# sudo journalctl -u ping_exporter -f | grep -i "error\|warn\|debug"


################################################################################
# 配置应用
################################################################################

# 修改此文件后，需要重启服务：
# sudo systemctl restart ping_exporter

# 不会自动重启，需要手动执行上述命令！
